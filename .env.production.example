POSTGRES_DB=penny
POSTGRES_USER=penny_app
POSTGRES_PASSWORD=replace-with-a-unique-database-password
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
APP_BASE_URL=https://penny.example.com
ALLOWED_ORIGINS=https://penny.example.com
TRUST_PROXY=true
FORCE_HTTPS=true
PASSWORD_RESET_FROM=Penny <no-reply@penny.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=replace-with-the-smtp-password
BACKUP_RETENTION_DAYS=14
