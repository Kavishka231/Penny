PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://app_user:use-a-unique-password@database.example.com:5432/penny
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
APP_BASE_URL=https://penny.example.com
ALLOWED_ORIGINS=https://penny.example.com
TRUST_PROXY=true
FORCE_HTTPS=true
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_EXPOSE_TOKEN=false
PASSWORD_RESET_FROM=Penny <no-reply@penny.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASSWORD=use-a-secret-manager
